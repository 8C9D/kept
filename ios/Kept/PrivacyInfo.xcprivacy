<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
	The privacy manifest. It ships in both configurations - unlike the
	Info.plist pair, there is nothing here that is true of a development
	build and false of a shipped one.

	⚠ This file and the App Store Connect privacy label must say the same
	thing. The label is filled in by hand in App Store Connect (it is not
	generated from this file), and "Data Not Collected" would be false:
	every receipt a person captures is uploaded to a server the owner operates
	and kept for the CRA's six-year retention period. The declaration below
	is the honest one, and it could not be written before wave 6 because
	where the data goes is part of what a label declares.

	Nothing here is used for tracking, and no data is shared with third
	parties or brokers - the only network destination is the Kept API.
-->
<plist version="1.0">
<dict>
	<key>NSPrivacyTracking</key>
	<false/>
	<key>NSPrivacyTrackingDomains</key>
	<array/>

	<key>NSPrivacyCollectedDataTypes</key>
	<array>
		<!--
			Receipt amounts, HST, and the supplier's tax number. Apple's
			"Other financial info" is the closest honest category: this is
			not payment information (no card number ever reaches the app -
			`payment_method` is free text a person types, like "visa ending
			4412") and it is not credit information.
		-->
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeOtherFinancialInfo</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>

		<!-- The scanned receipt images themselves. -->
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypePhotosorVideos</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>

		<!-- Vendor, category, notes, and the recognized text of a receipt. -->
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeOtherUserContent</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>

		<!--
			The Apple subject identifier, which is what the account is. It
			is the join key for everything above, which is why every entry
			here is declared as linked to identity.
		-->
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeUserID</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>

		<!--
			Sign in with Apple returns an email - usually a private relay
			address - which the server stores. Declared because it is
			stored, not because it is used: the app treats it as
			informational and never as identity (spec §5).
		-->
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeEmailAddress</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>

		<!--
			Apple provides the person's name only at first authorization and
			may provide none; when it does, it is stored as display_name.
		-->
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeName</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>

		<!--
			Behavioural telemetry (2026-08-28, POST /api/events): which
			screen actions happened and how many times - a field was
			edited three times before save, a suggestion was accepted or
			overridden - never a field's value. This is Apple's "Product
			Interaction" under Usage Data, not Other Usage Data, because
			every event names a specific in-app action. Linked because the
			server derives the user from the session token and stores
			every row against that account, the same as everything else in
			this file - there is no anonymous or aggregated path. Declared
			for Analytics, not App Functionality: the app works identically
			whether or not a batch of events ever reaches the server (the
			queue is fire-and-forget and drops events rather than block or
			retry), so this data informs product decisions, not the app's
			own behaviour. Not tracking - it is never linked to data from
			another company's app or site, and never leaves the Kept API.
		-->
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeProductInteraction</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAnalytics</string>
			</array>
		</dict>
	</array>

	<key>NSPrivacyAccessedAPITypes</key>
	<array>
		<!--
			UserDefaults holds exactly one key, the development server
			address override (ServerConfig.defaultsKey), read and written by
			this app only. CA92.1 is that reason verbatim.
		-->
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryUserDefaults</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>CA92.1</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
