#!/bin/sh
# core.hooksPath=.githooks replaces the machine-wide hooks in
# ~/dev/dotfiles/git-hooks, so the commit-message rule (short subject, no body,
# no AI attribution) is enforced by calling that commit-msg from here.
global="$HOME/dev/dotfiles/git-hooks/commit-msg"
if [ ! -x "$global" ]; then
  echo "commit-msg: global hook $global is missing or not executable;" >&2
  echo "refusing to commit without it. Restore ~/dev/dotfiles or bypass once with --no-verify." >&2
  exit 1
fi
exec "$global" "$@"
