<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
	Template for the scheduled backup (Runbook §4). NOT installed by any
	script - copying it into ~/Library/LaunchAgents is a deliberate operator
	step, like migrations.

	Before installing:
	  1. Replace __REPO__ with the absolute path to this checkout.
	  2. Create ~/.kept/backup.env (chmod 600) holding the five variables
	     db:backup requires: DATABASE_URL and the four BACKUP_STORAGE_*.
	     Secrets live in that file, never in this plist.
	  3. cp server/ops/net.keptapp.backup.plist ~/Library/LaunchAgents/
	     launchctl load ~/Library/LaunchAgents/net.keptapp.backup.plist
	  4. Run it once by hand and read the log:
	     launchctl start net.keptapp.backup
	     tail ~/Library/Logs/kept-backup.log

	Runs daily at 02:00 local. launchd runs a missed slot at next wake, so a
	closed laptop shifts the backup rather than skipping it.
-->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>net.keptapp.backup</string>
	<key>ProgramArguments</key>
	<array>
		<string>/bin/zsh</string>
		<string>-lc</string>
		<string>set -a; source "$HOME/.kept/backup.env"; set +a; cd __REPO__/server &amp;&amp; npm run db:backup</string>
	</array>
	<key>StartCalendarInterval</key>
	<dict>
		<key>Hour</key>
		<integer>2</integer>
		<key>Minute</key>
		<integer>0</integer>
	</dict>
	<key>StandardOutPath</key>
	<string>/Users/<user>/Library/Logs/kept-backup.log</string>
	<key>StandardErrorPath</key>
	<string>/Users/<user>/Library/Logs/kept-backup.log</string>
</dict>
</plist>
