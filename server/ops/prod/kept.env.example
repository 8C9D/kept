# /etc/kept/kept.env - the Kept API's production configuration on the VM.
# Copy this file there, fill every value, chmod 0600. Same names, same
# meanings as the Fly secrets they replace: docs/Runbook.md §0 is the
# authority on each one. No value in this example is real.
#
# NODE_ENV is set by the Dockerfile; PORT defaults to 3000 and the compose
# file binds it to loopback.

# Required in every environment.
DATABASE_URL=            # Neon connection string, the -pooler endpoint, with sslmode=require
SESSION_JWT_SECRET=      # same value as today, or every session is signed out
APPLE_CLIENT_ID=com.arthurzhang.kept

# Required in production.
ANTHROPIC_API_KEY=
STORAGE_ENDPOINT=        # https://<account-id>.r2.cloudflarestorage.com
STORAGE_BUCKET=kept
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=

# Optional, as set on Fly today.
EDGE_SHARED_SECRET=      # same value the Cloudflare Transform Rule adds
APPLE_WEB_CLIENT_ID=com.arthurzhang.kept.web
WEB_ORIGIN=https://keptapp.net
#RECEIPT_PARSE_MODEL=    # only if overridden on Fly

# Sign in with Apple revocation: all three or none (Runbook §0).
#APPLE_TEAM_ID=
#APPLE_SIGN_IN_KEY_ID=
#APPLE_SIGN_IN_PRIVATE_KEY=
