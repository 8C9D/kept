{
  "name": "kept-server",
  "private": true,
  "type": "module",
  "scripts": {
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "tsx src/db/seed.ts",
    "db:claim": "tsx src/db/claim.ts",
    "parse-accuracy": "tsx src/db/parseAccuracyReport.ts",
    "storage:init": "tsx src/storage/init.ts",
    "predev": "touch .env.local",
    "dev": "node --env-file=.env.local --import tsx src/index.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1104.0",
    "@aws-sdk/s3-request-presigner": "^3.1104.0",
    "@hono/node-server": "^2.1.0",
    "archiver": "^8.0.0",
    "drizzle-orm": "^0.45.2",
    "exceljs": "^4.4.0",
    "hono": "^4.13.0",
    "jose": "^6.2.8",
    "pg": "^8.16.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.8",
    "@types/archiver": "^8.0.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.4",
    "adm-zip": "^0.6.0",
    "drizzle-kit": "^0.31.4",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "vitest": "^4.1.10"
  }
}
